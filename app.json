{
  "expo": {
    "name": "Car Guy",
    "slug": "car-guy",
    "version": "2.5.0",
    "description": "Tu carro, al día. Mantenimiento, chequeos, combustible e historial de tus vehículos.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carguy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.xaviel.carguy",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Car Guy",
      "shortName": "Car Guy",
      "themeColor": "#121212",
      "backgroundColor": "#121212",
      "lang": "es-DO",
      "description": "Tu carro, al día. Mantenimiento, chequeos, combustible e historial de tus vehículos."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-rest.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Car Guy usa tus fotos para armar el álbum de tu carro.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Car Guy usa tu ubicación en segundo plano para registrar tus viajes automáticamente.",
          "locationWhenInUsePermission": "Car Guy usa tu ubicación para medir la velocidad y registrar viajes.",
          "motionUsagePermission": "Car Guy detecta si vas conduciendo para iniciar viajes automáticamente.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/images/notification-icon.png"
        }
      ],
      "expo-task-manager",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8b640709-63cc-4959-b027-05f71e81db23"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8b640709-63cc-4959-b027-05f71e81db23",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
