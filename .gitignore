# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# Supabase keys, including the service-role key, which must never be committed
# (04-conventions.md). The glob above does not match this name.
.env.supabase
.supabase-token

# Scratch the Supabase CLI writes when it talks to the project (linked-project
# id, version cache). Not configuration — the project ref lives in tools/.
supabase/.temp/

# Personal permission grants for this machine — notably permission to apply
# migrations to x-core, which is Music Hub's production database. That is a
# grant to this checkout, not something that should travel to a clone.
.claude/settings.local.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.vercel

# Xaviel's real Tu Combustible RD export (test input for the Phase 2 importer)
docs/imp-17092026/fixtures/tu-combustible-rd-backup.real.json

# Scratch output from Claude Code sessions — notes and generated files that
# belong to a working session, not to the project.
Claude outputs/

# Raw output of sql/000_inspect.sql — contains x-core's function bodies and
# schema details. Kept out of the repo; sql/001 carries only what it needs.
docs/imp-17092026/04-tracking/x-core-inspect.txt

# Release artefacts and signing material. The keystore especially: losing it
# means no Android update is ever accepted as the same app again, and putting it
# in a public repo is worse than losing it.
releases/
*.keystore
*.jks
